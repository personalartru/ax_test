{
  "name": "axel WP (apache + mariadb)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces",
  "forwardPorts": [8080],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "settings": {
        "files.associations": {
          "*.php": "php"
        }
      },
      "extensions": [
        "bmewburn.vscode-intelephense-client"
      ]
    }
  }
}